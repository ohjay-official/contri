{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "preserveSymlinks": true
  },
  "include": ["public/js/**/*.js", "server/**/*.js", "api/**/*.js", "dev/**/*.js", "test/**/*.js", "scripts/**/*.js"]
}
